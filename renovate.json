{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "controller-runtime pins the Kubernetes module minor, so these have to move in one PR",
      "groupName": "kubernetes modules",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apiextensions-apiserver",
        "k8s.io/apimachinery",
        "k8s.io/client-go",
        "sigs.k8s.io/controller-runtime"
      ]
    }
  ]
}
