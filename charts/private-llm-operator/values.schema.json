{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "modelServerCeilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuMilli",
        "memoryMiB",
        "contextSize",
        "parallelSlots"
      ],
      "properties": {
        "cpuMilli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16000
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "contextSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "parallelSlots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "slugPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutover",
        "entries"
      ],
      "properties": {
        "cutover": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uid",
              "namespace",
              "name",
              "mode"
            ],
            "properties": {
              "uid": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string",
                "enum": [
                  "legacy",
                  "derive"
                ]
              },
              "slug": {
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "properties": {
                  "mode": {
                    "const": "legacy"
                  }
                },
                "required": [
                  "slug"
                ]
              },
              {
                "properties": {
                  "mode": {
                    "const": "derive"
                  }
                },
                "not": {
                  "required": [
                    "slug"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
